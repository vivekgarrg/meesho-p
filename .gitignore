# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── Django ────────────────────────────────────────────────────────────────────
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
*.env

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
# Without this a *symlink* named node_modules slips past the patterns
# above — one pointing at a local temp dir was committed once already.
node_modules
# Scratch left by docs/verify.mjs while checking a recorded video.
docs/verify-player.html
docs/frame-*.png



# Build output
frontend/dist/
"frontend copy"/dist/
.vite/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Uploaded / generated files ────────────────────────────────────────────────
backend/uploads/
*.xlsx
*.xls
*.csv
# Bundled bulk-listing category templates are real Meesho export files the app
# ships with (not user-generated), so they're the one exception to the rule above.
!backend/meesho_app/bulk_listing_templates/*.xlsx

# Build artifacts (regenerated on deploy)
backend/staticfiles/
backend/frontend_build/

# Local dev HTTPS certs (self-signed, for phone camera testing)
.certs/
