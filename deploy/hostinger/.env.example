# Copy to deploy/hostinger/.env on the server and fill in real values.
# This file is read by the systemd service (EnvironmentFile).

# --- Django core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=rudam.in,www.rudam.in
CSRF_TRUSTED_ORIGINS=https://rudam.in,https://www.rudam.in

# --- CORS ---
# Since Django serves the frontend from the same origin, you can lock this down.
# The browser extension is handled separately: its chrome-extension:// origin is
# matched by CORS_ALLOWED_ORIGIN_REGEXES in settings.py (the id differs per
# install, so it cannot be listed here). Extension calls still require a JWT.
CORS_ALLOW_ALL=false
CORS_ALLOWED_ORIGINS=https://rudam.in,https://www.rudam.in

# --- Reverse proxy ---
# Trust nginx's X-Forwarded-Proto header so Django detects HTTPS correctly when
# running behind nginx (and Cloudflare). Keep true for this VPS deployment.
TRUST_PROXY_SSL_HEADER=true

# --- Database ---
# Option A: SQLite (simplest; file persists on the VPS disk)
# DB_ENGINE=sqlite
# SQLITE_PATH=/home/deploy/meesho-p/backend/db.sqlite3

# Option B: MySQL. Fill in the values shown in hPanel > Databases.
# NOTE: hPanel-created names are prefixed, e.g. u123456789_meesho.
# DB_HOST: use 127.0.0.1 only if MySQL runs on THIS VPS. If the DB was
# created in hPanel MySQL Databases (separate server), set DB_HOST to the
# hostname hPanel shows and enable Remote MySQL for the VPS IP.
DB_ENGINE=mysql
DB_NAME=u123456789_meesho
DB_USER=u123456789_meesho
DB_PASSWORD=your-db-password
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Seed users (used by create_seed_users management command) ---
# Only applied when the admin account is first created. Every deploy runs
# create_seed_users, and it will NOT touch an existing admin's password — a
# password you set in the app survives deploys.
SEED_ADMIN_PASSWORD=change-me
# Set to true for one deploy to force the admin password back to the value
# above (lock-out recovery), then remove it again.
# SEED_ADMIN_FORCE_PASSWORD=true

# --- Object storage: Cloudflare R2 (listing images) ---
# Optional. Leave blank and the Quadrant Cropper stays download-only; the
# upload button simply does not appear.
#
# S3_ENDPOINT_URL is R2's S3 API host, used for WRITING only — nothing written
# through it is publicly readable. Get it from Cloudflare > R2 > your bucket >
# Settings (it is https://<account_id>.r2.cloudflarestorage.com).
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=rudam-listing-images
# R2 > Manage R2 API Tokens > Create API Token, "Object Read & Write",
# scoped to this ONE bucket. The secret is shown once.
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
# How the images are READ. Must be an R2 custom domain (bucket > Settings >
# Public access > Connect Domain), not the r2.dev development URL, which
# Cloudflare rate-limits and labels dev-only. Meesho and Flipkart fetch these
# URLs server-side, so they have to be publicly reachable and fast.
S3_PUBLIC_BASE_URL=https://images.rudam.in
# R2 needs the literal "auto". For real AWS, use a region (e.g. ap-south-1).
S3_REGION=auto
